# ParkBotix — Sanitized Production Environment Configuration Template
# Never commit real credentials or secrets to version control.

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Security & Cryptographic Secrets (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-64-char-random-hex-secret"
QR_SIGNING_SECRET="replace-with-64-char-random-hex-secret"
COOKIE_SECURE="true"

# Initial SuperAdmin Bootstrap Account (only used when seeding an empty database)
SUPERADMIN_EMAIL="superadmin@yourdomain.com"
SUPERADMIN_PASSWORD="replace-with-strong-superadmin-password"

# Optional AI Providers (falls back to transparent live-DB deterministic engine if unset)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Optional UPI Merchant Configuration
UPI_MERCHANT_VPA="parkbotix.smart@okhdfcbank"

# Optional SMTP / Email Delivery for Password Reset OTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@parkbotix.com"

# Optional Legacy SQLite Source Path (for scripts/migrate-sqlite-to-postgres.ts)
SQLITE_SOURCE_PATH="./instance/parkbotix.db"
